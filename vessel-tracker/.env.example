# SeaVantage SVMP account (Basic Auth) — https://developer.seavantage.com/
SEAVANTAGE_USERNAME=
SEAVANTAGE_PASSWORD=

# Only override if SeaVantage gives you a different base URL
SEAVANTAGE_BASE_URL=https://svmp.seavantage.com/api/v1

# How often the server re-polls a ship's position (ms). SeaVantage has no
# push feed, so this is a plain interval poll — keep it well above their
# rate limit.
SEAVANTAGE_POLL_INTERVAL_MS=15000

# Minutes-old a position report may be and still count as "current" when
# fetching a ship's snapshot. SVMP's docs don't state the unit for
# /ship/snapshot/:shipId's "range" param — this assumes minutes; widen it
# if positions come back empty.
SEAVANTAGE_SNAPSHOT_RANGE=60

# Get a public access token at https://account.mapbox.com/access-tokens/
# Restrict it to your dev/prod URLs in the Mapbox dashboard — this token still
# ships to the browser, .env only keeps it out of git.
MAPBOX_TOKEN=

# Local server port
PORT=8787
